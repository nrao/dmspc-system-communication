# This is a template you can use to build your .env file.
# this .env contains local dev vars AND DigitalOcean droplet vars.
# comment/uncomment env vars depending on which environment you are deploying your services.


#=====================================
# LOCAL DEV ENV VARIABLES
#=====================================
# To spin all ~34 containers up locally on your machine, you need the below env variables:

# generate your own django secret key for local development using the following command in your terminal (make sure you have python installed):
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# Django Settings:
DJANGO_SECRET_KEY="your-django-secret-key"      # you must provide
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ngradar-website-network
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DSOC_VOLUME_SIZE=5 #GB can change to make storage at DSOC larger/smaller
# seaweedfs S3 gateway:
WEED_S3_ACCESS_KEY=dev_user
WEED_S3_SECRET_KEY=dev_password
WEED_S3_BUCKET=ddm-images
WEED_S3_ENDPOINT=http://seaweedfs:8333 # saves the image using Docker DNS
WEED_S3_PUBLIC_ENDPOINT=http://images.localhost
SEAWEEDFS_CERTRESOLVER=traefik.http.routers.seaweedfs.tls.certresolver=le
# LOCAL-DB vars:
DATABASE_URL=postgresql://ngradar_website:ngradar_website@postgres:5432/localdev?sslmode=disable
POSTGRES_USER=ngradar_website
POSTGRES_PASSWORD=ngradar_website
POSTGRES_DB=localdev
# kafka vars:
KAFKA_BOOTSTRAP_SERVERS=kafka-node-1:19092,kafka-node-2:29092,kafka-node-3:39092
KAFKA_CONTROLLER_QUOROM_VOTERS=1@kafka-node-1:19093,2@kafka-node-2:29093,3@kafka-node-3:39093
# traefik vars:
WEBSITE_DOMAIN=localhost
WEBSITE_DOMAIN_NAME=localhost
PUBLIC_BIND_IP=127.0.0.1
CERTRESOLVER=ngradar.environment=local
DASHBOARD_CERTRESOLVER=ngradar.environment=local
# etransfer vars:
ETD_HOST=etr_daemon
ETD_COMMAND_PORT=4004
# grafana
GRAFANA_USER=your-grafana-password
GRAFANA_ADMIN_PASSWORD=your-grafana-password
# ./control.sh command env vars (need to be set, but not needed for local ./control.sh commands)
# if not using DO Droplets at all in the future, remove the droplets-up/droplets-down commands in ./control.sh script
# which need the below IP addresses:
DSOC_DROPLET_IP=DO-DSOC-DROPLET-IP-ADDRESS          # you must provide
VLBA_1_DROPLET_IP=DO-VLBA-1-DROPLET-IP-ADDRESS      # you must provide
VLBA_2_DROPLET_IP=DO-VLBA-2-DROPLET-IP-ADDRESS      # you must provide
VLBA_3_DROPLET_IP=DO-VLBA-3-DROPLET-IP-ADDRESS      # you must provide
GBT_DROPLET_IP=DO-GBT-DROPLET-IP-ADDRESS            # you must provide
REMOTE_REPO=name-of-your-remote-github-repo         # you must provide
# k6 testing vars:
K6_USERNAME=k6-testuser
K6_PASSWORD=k6-password
K6_IMAGE_ID=replace-with-an-imagekey-id-from-your-db
#expedat vars:
SVD_PASSWORD=your_mac_password                     # you must provide
SVD_IP=expedat_server
SVD_USER=your_mac_username                         # you must provide
RECIPIENT_DIR=/Users/your_mac_username/DMSPC_GitHub/Expedat_Resources/      # you must provide
MVD_LOC=/Users/your_mac_username/DMSPC_GitHub/Expedat_Resources/            # you must provide
MVD_FILEPATH=/Users/your_mac_username/Documents/ngRadar/Debbie.png          # you must provide
EXPEDAT_MODE=stream                                # can use 'stream' or 'transfer' modes if desired
EXPEDAT_STREAM_MB=100



