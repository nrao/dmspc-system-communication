# ETD_COMMAND_PORT=4004
# DSOC_DROPLET_IP=dsoc-droplet-ip-address       # you must provide
# VLBA_1_DROPLET_IP=vlba-1-doplet-ip-address    # you must provide
# VLBA_2_DROPLET_IP=vlba-2-doplet-ip-address    # you must provide
# VLBA_3_DROPLET_IP=vlba-3-doplet-ip-address    # you must provide
# GBT_DROPLET_IP=gbt-droplet-ip-address         # you must provide
# if on dev branch, using expedat for data transport:
# SVD_PASSWORD=your_mac_password                  # you must provide
# SVD_IP=dsoc-droplet-ip-address                  # you must provide
# SVD_USER=your_mac_username                      # you must provide
# EXPEDAT_MODE=stream                             # can use 'stream' or 'transfer' modes if desired
# EXPEDAT_STREAM_MB=10
# REMOTE_REPO=name-of-your-remote-github-repo         # you must provide
